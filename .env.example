# Copier vers .env à la racine ou utiliser backend/.env + frontend/.env.local

# PostgreSQL
DATABASE_URL=postgresql://veille:veille@127.0.0.1:5432/veille?serverVersion=16&charset=utf8
POSTGRES_DB=veille
POSTGRES_USER=veille
POSTGRES_PASSWORD=veille

# Redis / Messenger
REDIS_URL=redis://127.0.0.1:6379
MESSENGER_TRANSPORT_DSN=redis://127.0.0.1:6379/messages

# Mail
MAILER_DSN=smtp://127.0.0.1:1025

# MinIO / S3
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=veille
S3_SECRET_KEY=veilleminio
S3_BUCKET=veille

# Symfony
APP_ENV=dev
APP_SECRET=change_me_generate_a_real_secret

# Next.js
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
